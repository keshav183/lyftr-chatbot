# Comma-separated key pool (>= 2). Ids are key_1, key_2, ... in this order. Never commit real keys.
LLM_API_KEYS=your-key-1,your-key-2
# Any LiteLLM model name that matches your keys' provider
LLM_MODEL=gemini/gemini-2.5-flash
DATABASE_URL=sqlite:////data/app.db
# Comma-separated CORS origins (add your deployed frontend URL)
ALLOWED_ORIGINS=http://localhost:3000
# Enables the X-Simulate-Failure test hook (must be true on the deployed backend)
ENABLE_FAILURE_SIMULATION=true
# LiteLLM cache: "local" (in-memory) or "disk" (survives restarts, stored under CACHE_DIR)
CACHE_TYPE=disk
CACHE_DIR=/data/litellm_cache
# Frontend build-time backend URL (used by docker compose)
VITE_API_URL=http://localhost:8000
# Offline demo/testing: canned replies, no provider calls
MOCK_LLM=false
